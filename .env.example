# ---------------------------------------------------------------------------
# HisabSetu AI — copy this file to .env and fill in your own values.
# NEVER commit .env. The key stays on the server and is never sent to the browser.
# ---------------------------------------------------------------------------

# Get a key from https://app.gnani.ai/voice/ (see docs.gnani.ai quick start).
GNANI_API_KEY=your_gnani_api_key_here

# Official docs (Oct 2026) use this host and the X-API-Key-ID header.
# If your key was issued for another Gnani gateway, override these:
GNANI_BASE_URL=https://api.vachana.ai
GNANI_AUTH_HEADER=X-API-Key-ID
# Set to "Bearer" only if your Gnani account documents that scheme:
GNANI_AUTH_SCHEME=

# Prisma STT
GNANI_STT_PATH=/stt/v3
GNANI_STT_LANGUAGE=hi-IN

# Timbre TTS — model and voice must belong to the same model family.
GNANI_TTS_PATH=/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Nalini
GNANI_TTS_LANGUAGE=hi-IN
GNANI_TTS_SPEED=1.0
GNANI_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# App (defaults are fine for a local demo)
# ---------------------------------------------------------------------------
VOICE_KHATA_DB_URL=sqlite:///./voice_khata.db
VOICE_KHATA_SEED=1
MAX_RECORD_SECONDS=30
MAX_AUDIO_BYTES=8000000
PENDING_TTL_MINUTES=15
MAX_AMOUNT_RUPEES=10000000
MAX_TTS_CHARS=400

# Optional: point at an FFmpeg binary if it is not on PATH.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
